#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_MAIN_ICON ICON "../assets/app.ico"
1 RT_MANIFEST "app.manifest"

IDD_APP_RULES DIALOGEX 0, 0, 610, 338
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Application profiles"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Specific app filters take priority. Choose the default below for applications without a binding.", IDC_APP_RULES_HINT, 12, 10, 586, 20
    LTEXT "Unassigned applications", -1, 12, 36, 586, 12
    LTEXT "&Display", -1, 12, 53, 164, 12
    COMBOBOX IDC_FALLBACK_DISPLAY, 12, 69, 164, 86, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Default f&ilter", -1, 190, 53, 408, 12
    COMBOBOX IDC_FALLBACK_PROFILE, 190, 69, 408, 126, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Applications", -1, 12, 104, 164, 12
    LISTBOX IDC_APPLICATION_LIST, 12, 119, 164, 158, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Add app...", IDC_ADD_APPLICATION, 12, 285, 78, 18
    PUSHBUTTON "Remove app", IDC_REMOVE_APPLICATION, 96, 285, 80, 18, WS_DISABLED
    PUSHBUTTON "Add active app...", IDC_ADD_ACTIVE_APPLICATION, 12, 308, 164, 18
    LTEXT "&Filters", -1, 190, 104, 408, 12
    CONTROL "", IDC_APP_RULE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 190, 119, 408, 158
    PUSHBUTTON "Add filter...", IDC_ADD_APP_FILTER, 190, 285, 78, 18
    PUSHBUTTON "&Edit...", IDC_EDIT_APP_FILTER, 274, 285, 58, 18, WS_DISABLED
    PUSHBUTTON "&Remove", IDC_REMOVE_APP_RULE, 338, 285, 68, 18, WS_DISABLED
    PUSHBUTTON "Move up", IDC_MOVE_RULE_UP, 412, 285, 88, 18, WS_DISABLED
    PUSHBUTTON "Move &down", IDC_MOVE_RULE_DOWN, 506, 285, 92, 18, WS_DISABLED
    PUSHBUTTON "&Set as default", IDC_USE_APP_FILTER, 190, 308, 96, 18, WS_DISABLED
    PUSHBUTTON "Edit settings...", IDC_EDIT_FILTER_SETTINGS, 292, 308, 110, 18, WS_DISABLED
    DEFPUSHBUTTON "&Save", IDOK, 430, 308, 78, 18
    PUSHBUTTON "Cancel", IDCANCEL, 520, 308, 78, 18
END

IDD_RUNNING_APPS DIALOGEX 0, 0, 570, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose a running application"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Choose a running app below, or browse for an executable.", -1, 12, 12, 546, 18
    LTEXT "Running &applications", -1, 12, 33, 546, 12
    CONTROL "", IDC_RUNNING_APP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 12, 49, 546, 144
    LTEXT "", IDC_RUNNING_APP_HINT, 12, 201, 546, 30, SS_NOPREFIX
    PUSHBUTTON "&Refresh", IDC_RUNNING_APP_REFRESH, 12, 240, 78, 18
    PUSHBUTTON "&Browse...", IDC_RUNNING_APP_BROWSE, 98, 240, 90, 18
    DEFPUSHBUTTON "&Select", IDOK, 394, 240, 78, 18, WS_DISABLED
    PUSHBUTTON "Cancel", IDCANCEL, 480, 240, 78, 18
END

IDD_APP_RULE_EDITOR DIALOGEX 0, 0, 420, 210
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Application filter"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Filter &name", -1, 12, 12, 396, 12
    EDITTEXT IDC_RULE_NAME, 12, 28, 396, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Application executable", -1, 12, 50, 396, 12
    EDITTEXT IDC_RULE_EXECUTABLE, 12, 66, 232, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Browse...", IDC_RULE_BROWSE, 250, 65, 74, 18
    PUSHBUTTON "Active app", IDC_RULE_CAPTURE_APP, 330, 65, 78, 18
    LTEXT "&Profile", -1, 12, 90, 190, 12
    COMBOBOX IDC_RULE_PROFILE, 12, 106, 190, 86, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Display", -1, 218, 90, 190, 12
    COMBOBOX IDC_RULE_DISPLAY, 218, 106, 190, 86, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "This enabled filter becomes the application's default for the selected display after saving application profiles.", IDC_RULE_HINT, 12, 130, 396, 24
    CONTROL "&Enabled", IDC_RULE_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 163, 170, 12
    DEFPUSHBUTTON "&Save", IDOK, 244, 180, 78, 18
    PUSHBUTTON "Cancel", IDCANCEL, 330, 180, 78, 18
END

IDD_APP_FILTER_SETTINGS DIALOGEX 0, 0, 350, 260
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Application filter settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Gamma", -1, 12, 22, 216, 14
    EDITTEXT IDC_APP_FILTER_VALUE_BASE, 240, 20, 98, 16, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Brightness", -1, 12, 50, 216, 14
    EDITTEXT (IDC_APP_FILTER_VALUE_BASE + 1), 240, 48, 98, 16, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Contrast", -1, 12, 78, 216, 14
    EDITTEXT (IDC_APP_FILTER_VALUE_BASE + 2), 240, 76, 98, 16, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Red gain", -1, 12, 106, 216, 14
    EDITTEXT (IDC_APP_FILTER_VALUE_BASE + 3), 240, 104, 98, 16, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Gr&een gain", -1, 12, 134, 216, 14
    EDITTEXT (IDC_APP_FILTER_VALUE_BASE + 4), 240, 132, 98, 16, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "B&lue gain", -1, 12, 162, 216, 14
    EDITTEXT (IDC_APP_FILTER_VALUE_BASE + 5), 240, 160, 98, 16, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Changes apply only to this application filter.", IDC_APP_FILTER_HINT, 12, 188, 326, 28
    DEFPUSHBUTTON "&Save values", IDOK, 160, 230, 86, 18
    PUSHBUTTON "Cancel", IDCANCEL, 252, 230, 86, 18
END
