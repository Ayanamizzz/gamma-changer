#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_MAIN_ICON ICON "../assets/app.ico"
1 RT_MANIFEST "app.manifest"

IDD_APP_PROFILES DIALOGEX 0, 0, 400, 290
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "App profiles"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Use a profile automatically while a specific app is in front. Other apps use the profile chosen at the bottom.", IDC_APP_INTRO, 14, 12, 372, 18
    AUTOCHECKBOX "&Switch profiles automatically", IDC_APP_AUTO_SWITCH, 14, 36, 240, 12
    LTEXT "&Display", IDC_APP_DISPLAY_LABEL, 14, 60, 40, 10
    COMBOBOX IDC_APP_DISPLAY, 60, 58, 326, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_APP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 14, 78, 372, 124
    PUSHBUTTON "&Add app...", IDC_APP_ADD, 14, 208, 64, 15
    PUSHBUTTON "&Change...", IDC_APP_CHANGE, 82, 208, 58, 15, WS_DISABLED
    PUSHBUTTON "&Remove", IDC_APP_REMOVE, 144, 208, 58, 15, WS_DISABLED
    LTEXT "&Other apps use", IDC_APP_OTHER_LABEL, 14, 236, 64, 10
    COMBOBOX IDC_APP_OTHER_PROFILE, 80, 234, 306, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_APP_HINT, 14, 256, 230, 26, SS_NOPREFIX
    DEFPUSHBUTTON "Save", IDOK, 268, 266, 56, 15
    PUSHBUTTON "Cancel", IDCANCEL, 330, 266, 56, 15
END

IDD_APP_ASSIGN DIALOGEX 0, 0, 380, 252
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose app"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "&Apps with an open window", -1, 14, 12, 352, 10
    CONTROL "", IDC_ASSIGN_APP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 14, 24, 352, 120
    LTEXT "", IDC_ASSIGN_PATH, 14, 148, 352, 20, SS_NOPREFIX
    PUSHBUTTON "&Refresh", IDC_ASSIGN_REFRESH, 14, 170, 56, 15
    PUSHBUTTON "&Browse...", IDC_ASSIGN_BROWSE, 74, 170, 62, 15
    LTEXT "&Profile", -1, 14, 200, 40, 10
    COMBOBOX IDC_ASSIGN_PROFILE, 56, 198, 310, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_ASSIGN_HINT, 14, 222, 230, 22, SS_NOPREFIX
    DEFPUSHBUTTON "OK", IDOK, 248, 228, 56, 15, WS_DISABLED
    PUSHBUTTON "Cancel", IDCANCEL, 310, 228, 56, 15
END
